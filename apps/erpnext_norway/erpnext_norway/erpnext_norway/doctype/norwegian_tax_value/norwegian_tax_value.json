{
 "doctype": "DocType",
 "name": "Norwegian Tax Value",
 "module": "ERPNext Norway",
 "engine": "InnoDB",
 "istable": 1,
 "editable_grid": 1,
 "field_order": [
  "account",
  "outside_saldo",
  "non_saldo_deduction",
  "tax_method",
  "tax_opening",
  "tax_closing",
  "result_effect",
  "wealth_method",
  "wealth_value",
  "reference"
 ],
 "fields": [
  {
   "fieldname": "account",
   "label": "Account",
   "fieldtype": "Link",
   "options": "Account",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "outside_saldo",
   "label": "Asset outside tax saldo groups",
   "fieldtype": "Check",
   "default": "0",
   "description": "Document the treatment of land, time-limited rights or another asset outside declining-balance tax depreciation. Book depreciation remains native."
  },
  {
   "fieldname": "non_saldo_deduction",
   "label": "Documented annual non-saldo tax deduction",
   "fieldtype": "Currency",
   "options": "NOK",
   "depends_on": "eval:doc.outside_saldo"
  },
  {
   "fieldname": "tax_method",
   "label": "Tax valuation",
   "fieldtype": "Select",
   "options": "Not assessed\nBook values confirmed\nDocumented values",
   "default": "Not assessed",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "tax_opening",
   "label": "Documented opening tax value",
   "fieldtype": "Currency",
   "options": "NOK",
   "depends_on": "eval:doc.tax_method==='Documented values'"
  },
  {
   "fieldname": "tax_closing",
   "label": "Documented closing tax value",
   "fieldtype": "Currency",
   "options": "NOK",
   "depends_on": "eval:doc.tax_method==='Documented values'"
  },
  {
   "fieldname": "result_effect",
   "label": "Include change in book/tax difference in business profit",
   "fieldtype": "Check",
   "default": "0",
   "description": "Use for documented differences on other balance accounts, for example inventory and receivables. Asset tax pools and accumulated depreciation are handled separately."
  },
  {
   "fieldname": "wealth_method",
   "label": "Wealth valuation before discount",
   "fieldtype": "Select",
   "options": "Not assessed\nTax value before discount\nDocumented value\nNot taxable",
   "default": "Not assessed",
   "reqd": 1
  },
  {
   "fieldname": "wealth_value",
   "label": "Documented wealth value before discount",
   "fieldtype": "Currency",
   "options": "NOK",
   "depends_on": "eval:doc.wealth_method==='Documented value'"
  },
  {
   "fieldname": "reference",
   "label": "Valuation documentation",
   "fieldtype": "Small Text",
   "reqd": 1
  }
 ],
 "permissions": []
}
